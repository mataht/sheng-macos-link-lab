--- a/scripts/qemu-entry/gdb_packets.py
+++ b/scripts/qemu-entry/gdb_packets.py
@@ -1,5 +1,7 @@
 """Buffered packet reception for the bounded QEMU GDB observer."""
 
+import re
+
 
 class Packets:
     def __init__(self, connection):
@@ -7,6 +9,26 @@
         self.pending = bytearray()
 
     def request(self, value):
+        # QEMU 8.2 accepts at most 2048 bytes per memory-read response.
+        # Keep logical requests intact while collecting real bounded reads.
+        memory = re.fullmatch(r'm([0-9a-fA-F]+),([0-9a-fA-F]+)', value or '')
+        if memory and int(memory[2], 16) > 1024:
+            address, length = (int(part, 16) for part in memory.groups())
+            if address + length > 1 << 64 or length > 1024 * 1024:
+                raise RuntimeError('GDB memory read exceeds observer bounds')
+            chunks = []
+            for offset in range(0, length, 1024):
+                size = min(1024, length - offset)
+                raw = self._request(f'm{address + offset:x},{size:x}')
+                if re.fullmatch(r'E[0-9a-fA-F]{2}', raw):
+                    return raw  # Preserve the actual error; never pad partial data.
+                if len(raw) != size * 2 or not re.fullmatch(r'[0-9a-fA-F]+', raw):
+                    raise RuntimeError('Incomplete GDB memory-read chunk')
+                chunks.append(raw)
+            return ''.join(chunks)
+        return self._request(value)
+
+    def _request(self, value):
         if value is None:
             self.connection.settimeout(3)
             self.connection.sendall(b'\x03')
