+    def test_reads_above_1024_bytes_are_split_for_qemu(self):
+        # QEMU 8.2 answers E22 to memory reads above 2048 bytes; split into 1 KiB requests.
+        replies = [frame(bytes([0x30 + index % 10]) * 2048) for index in range(16)]
+        connection = Socket(replies)
+        result = Packets(connection).request('m1000,4000')
+        self.assertEqual(result, ''.join(chr(0x30 + index % 10) * 2048 for index in range(16)))
+        requests = [packet[1:packet.index(b'#')].decode() for packet in connection.sent if packet.startswith(b'$')]
+        self.assertEqual(requests, [f'm{0x1000 + offset:x},400' for offset in range(0, 0x4000, 0x400)])
+
+    def test_failed_chunk_returns_the_real_error(self):
+        connection = Socket([frame(b'00' * 1024), frame(b'E22')])
+        self.assertEqual(Packets(connection).request('m1000,800'), 'E22')
+        with self.assertRaisesRegex(RuntimeError, 'Incomplete'):
+            Packets(Socket([frame(b'00' * 1023)])).request('m1000,800')
+        with self.assertRaisesRegex(RuntimeError, 'bounds'):
+            Packets(Socket([])).request('m1000,100001')
+
     def test_corruption_and_truncation_are_rejected(self):
         with self.assertRaisesRegex(RuntimeError, 'checksum'):
