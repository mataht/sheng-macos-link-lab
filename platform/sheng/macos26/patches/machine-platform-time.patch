+long ArmDTPlatform::getGMTTimeOfDay (void)
+{
+  const long base = __atomic_load_n (&sheng_platform_rtc_seconds, __ATOMIC_ACQUIRE);
+  if (base <= 0) {
+    return 0;
+  }
+  uint64_t now = 0;
+  uint64_t elapsed = 0;
+  clock_get_uptime (&now);
+  absolutetime_to_nanoseconds (now - sheng_platform_rtc_stamp, &elapsed);
+  return base + (long) (elapsed / 1000000000ULL);
+}
