+// The wall clock handed over by the NativeRtc companion (sheng-rtc=2, hardware only): Unix seconds and the uptime
+// they were taken at. Zero keeps the platform expert's default, no clock.
+extern "C" {
+volatile long sheng_platform_rtc_seconds = 0;
+volatile uint64_t sheng_platform_rtc_stamp = 0;
+}
