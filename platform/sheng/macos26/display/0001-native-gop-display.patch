+        {static_cast<uint32_t>(shown - fDiagLast[1]), 4},       // frames per second
+        {static_cast<uint32_t>(busy - fDiagLast[2]), 4},        // swap_wait Busy per second
+        {fDiagMask, 2},                                         // layer mask of the last swap
+        {static_cast<uint32_t>(fCursorLayerSwaps), 6},          // swaps with a surface besides the scanned-out one
+        {static_cast<uint32_t>(reports - fDiagLast[3]), 4},     // touch reports per second
+        {sheng_touch_diag[1], 4},                               // finger-down transitions
+        {sheng_touch_diag[2], 4},                               // finger-up transitions
+        {sheng_touch_diag[3], 4},                               // last X (0..7fff)
+        {sheng_touch_diag[4], 4},                               // last Y (0..7fff)
